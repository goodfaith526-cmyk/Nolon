// Database schema. Rules (see AGENTS.md):
// - Money columns are Decimal (@db.Decimal(18, 4)), never Float.
// - Branch-owned tables carry branch_id and every query filters on it.
// - Immutability of posted journal entries is enforced by triggers in raw SQL migrations.
// - Every migration is reviewed by a human before merge.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Key/value system settings. Foundation table only: business tables arrive with their modules.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

/// Operating branch (DXB, JED, PTS, ATB, KRT). Root of branch scoping: branch-owned tables
/// reference it. Codes must match BRANCH_CODES in @nolon/shared.
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(10)
  nameEn          String   @map("name_en")
  nameAr          String   @map("name_ar")
  /// ISO 3166-1 alpha-2.
  countryCode     String   @map("country_code") @db.Char(2)
  city            String
  /// ISO 4217 code; must exist in the currencies master.
  defaultCurrency String   @map("default_currency") @db.Char(3)
  currency        Currency @relation(fields: [defaultCurrency], references: [code], onUpdate: Restrict, onDelete: Restrict)
  /// IANA time zone, e.g. Asia/Dubai.
  timezone        String
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users      UserBranch[]
  customers  Customer[]
  rateCards  RateCard[]
  quotations Quotation[]
  bookings   Booking[]
  shipments  Shipment[]
  documents  Document[]

  @@map("branches")
}

/// Currency master. Users add currencies here (no code change or deploy). The initial set
/// (USD, AED, SAR, SDG, EUR) is inserted by the migration that creates the table, because
/// branches reference it in every environment. Deactivate a currency; never delete one that is
/// in use (foreign keys restrict it).
model Currency {
  /// ISO 4217, e.g. SDG.
  code          String   @id @db.Char(3)
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  symbol        String?  @db.VarChar(8)
  /// Minor units used when rounding amounts in this currency (ISO 4217 exponent, e.g. 2).
  decimalPlaces Int      @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches             Branch[]
  customersPreferred   Customer[]  @relation("CustomerPreferredCurrency")
  customersCreditLimit Customer[]  @relation("CustomerCreditLimitCurrency")
  rateCards            RateCard[]
  quotations           Quotation[]

  @@map("currencies")
}

/// Fixed roles from the permissions annex (02a). Each role's permissions live in code
/// (ROLE_PERMISSIONS in @nolon/shared), not in the database: there is no custom role editor.
enum Role {
  ADMINISTRATOR
  MANAGEMENT
  BRANCH_MANAGER
  SALES
  OPERATIONS
  FINANCE
  WAREHOUSE
  CUSTOMS
  DRIVER

  @@map("role")
}

/// Staff user who signs in to the web app. A user can hold several roles and several branches;
/// permissions add up across roles.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; the sign-in lookup normalizes the same way.
  email           String    @unique @db.VarChar(254)
  fullName        String    @map("full_name") @db.VarChar(200)
  /// scrypt hash in the form scrypt$N$r$p$salt$hash (base64). Never the plain password.
  passwordHash    String    @map("password_hash")
  /// "ar" or "en", one of LOCALES in @nolon/shared.
  preferredLocale String    @default("ar") @map("preferred_locale") @db.VarChar(5)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles    UserRole[]
  branches UserBranch[]
  sessions Session[]

  customersCreated  Customer[]      @relation("CustomerCreatedBy")
  ratesCreated      RateCard[]      @relation("RateCreatedBy")
  ratesApproved     RateCard[]      @relation("RateApprovedBy")
  quotationsCreated Quotation[]     @relation("QuotationCreatedBy")
  bookingsCreated   Booking[]       @relation("BookingCreatedBy")
  shipmentsCreated  Shipment[]      @relation("ShipmentCreatedBy")
  shipmentEvents    ShipmentEvent[]
  documentsUploaded Document[]      @relation("DocumentUploadedBy")
  documentsDeleted  Document[]      @relation("DocumentDeletedBy")

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Branches a user may work in. Administrator and Management see every branch through their
/// role; every other role sees only the branches listed here.
model UserBranch {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// Server-side sign-in session. The browser holds a random token in an httpOnly cookie; only its
/// SHA-256 hash is stored, so a database leak does not leak usable sessions. Sign-out sets
/// revokedAt; expired and revoked sessions are rejected.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token, hex.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------------------------
// Group 2: master data, customers, rates, quotations, bookings.
// Branch-owned tables carry branch_id; services filter on the user's allowed branches.
// Currency columns reference the currency master; services check the currency is active.
// ---------------------------------------------------------------------------------------------

/// Per-document running numbers (e.g. NOL-QT-2026-000001). Incremented inside the transaction that
/// creates the document, so numbers are unique and gap-free under concurrency.
model NumberSequence {
  docType   String @map("doc_type") @db.VarChar(30)
  /// "2026" for yearly sequences, "" for never-resetting ones.
  periodKey String @default("") @map("period_key") @db.VarChar(10)
  nextValue BigInt @default(1) @map("next_value")

  @@id([docType, periodKey])
  @@map("number_sequences")
}

enum LocationKind {
  PORT
  CITY
  BORDER
  OTHER

  @@map("location_kind")
}

/// Ports, cities and border points used in routes. Master data the client extends.
model Location {
  id          String       @id @default(uuid()) @db.Uuid
  /// UN/LOCODE where one exists (AEJEA, SAJED, SDPZU), otherwise an internal code.
  code        String       @unique @db.VarChar(10)
  kind        LocationKind
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  /// ISO 3166-1 alpha-2.
  countryCode String       @map("country_code") @db.Char(2)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  ratesFrom      RateCard[]      @relation("RateOrigin")
  ratesTo        RateCard[]      @relation("RateDestination")
  quotationsFrom Quotation[]     @relation("QuotationOrigin")
  quotationsTo   Quotation[]     @relation("QuotationDestination")
  bookingsFrom   Booking[]       @relation("BookingOrigin")
  bookingsTo     Booking[]       @relation("BookingDestination")
  shipmentsFrom  Shipment[]      @relation("ShipmentOrigin")
  shipmentsTo    Shipment[]      @relation("ShipmentDestination")
  shipmentsAt    Shipment[]      @relation("ShipmentCurrentLocation")
  events         ShipmentEvent[]

  @@map("locations")
}

/// 20GP, 40GP, 40HC, OTHER... Master data the client extends.
model ContainerType {
  code      String   @id @db.VarChar(10)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rates              RateCard[]
  bookingItems       BookingItem[]
  shipmentItems      ShipmentItem[]
  shipmentContainers ShipmentContainer[]

  @@map("container_types")
}

/// Freight, THC, documentation, customs... The kinds of charge on a rate or quotation line.
model ChargeType {
  code      String   @id @db.VarChar(20)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rates          RateCard[]
  quotationLines QuotationLine[]

  @@map("charge_types")
}

enum ShippingMode {
  SEA
  ROAD

  @@map("shipping_mode")
}

enum LoadType {
  FCL
  LCL

  @@map("load_type")
}

enum CargoType {
  CONTAINER
  PALLET
  BARREL
  GENERAL

  @@map("cargo_type")
}

enum RateUnit {
  PER_CONTAINER
  PER_CBM
  PER_KG
  PER_PALLET
  PER_BARREL
  PER_PIECE
  PER_SHIPMENT

  @@map("rate_unit")
}

enum CustomerKind {
  INDIVIDUAL
  COMPANY

  @@map("customer_kind")
}

/// A NOLON customer. Branch-owned: staff see the customers of their branches only.
model Customer {
  id                  String       @id @default(uuid()) @db.Uuid
  /// NOL-CUS-000001
  number              String       @unique @db.VarChar(30)
  branchId            String       @map("branch_id") @db.Uuid
  kind                CustomerKind
  name                String       @db.VarChar(200)
  companyName         String?      @map("company_name") @db.VarChar(200)
  /// E.164, e.g. +249912345678.
  phone               String       @db.VarChar(20)
  whatsapp            String?      @db.VarChar(20)
  email               String?      @db.VarChar(254)
  countryCode         String?      @map("country_code") @db.Char(2)
  city                String?      @db.VarChar(100)
  address             String?
  taxNumber           String?      @map("tax_number") @db.VarChar(50)
  preferredCurrency   String?      @map("preferred_currency") @db.Char(3)
  preferredLocale     String       @default("ar") @map("preferred_locale") @db.VarChar(5)
  paymentTermsDays    Int          @default(0) @map("payment_terms_days")
  creditLimit         Decimal?     @map("credit_limit") @db.Decimal(18, 4)
  creditLimitCurrency String?      @map("credit_limit_currency") @db.Char(3)
  notes               String?
  isActive            Boolean      @default(true) @map("is_active")
  createdById         String       @map("created_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  preferredCurrencyRef   Currency?         @relation("CustomerPreferredCurrency", fields: [preferredCurrency], references: [code], onDelete: Restrict)
  creditLimitCurrencyRef Currency?         @relation("CustomerCreditLimitCurrency", fields: [creditLimitCurrency], references: [code], onDelete: Restrict)
  createdBy              User              @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  contacts               CustomerContact[]
  parties                Party[]
  quotations             Quotation[]
  bookings               Booking[]
  shipments              Shipment[]

  @@index([branchId])
  @@index([phone])
  @@map("customers")
}

/// A person authorized to act for a customer: inquire, receive cargo or receive documents.
model CustomerContact {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  name                String   @db.VarChar(200)
  position            String?  @db.VarChar(100)
  phone               String   @db.VarChar(20)
  email               String?  @db.VarChar(254)
  idNumber            String?  @map("id_number") @db.VarChar(50)
  canInquire          Boolean  @default(true) @map("can_inquire")
  canReceiveCargo     Boolean  @default(false) @map("can_receive_cargo")
  canReceiveDocuments Boolean  @default(false) @map("can_receive_documents")
  isPrimary           Boolean  @default(false) @map("is_primary")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([phone])
  @@map("customer_contacts")
}

/// Shipper / consignee / notify party. Separate from customers (scope 6); each entry belongs to
/// one customer's address book.
model Party {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String   @db.VarChar(200)
  companyName String?  @map("company_name") @db.VarChar(200)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(254)
  countryCode String?  @map("country_code") @db.Char(2)
  city        String?  @db.VarChar(100)
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer           Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingsShipper    Booking[]  @relation("BookingShipper")
  bookingsConsignee  Booking[]  @relation("BookingConsignee")
  bookingsNotify     Booking[]  @relation("BookingNotify")
  shipmentsShipper   Shipment[] @relation("ShipmentShipper")
  shipmentsConsignee Shipment[] @relation("ShipmentConsignee")
  shipmentsNotify    Shipment[] @relation("ShipmentNotify")

  @@index([customerId])
  @@map("parties")
}

enum RateStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("rate_status")
}

/// A selling rate for a route. Sales create and edit drafts; a Branch Manager (or anyone with
/// rates:approve) approves. Only approved rates feed quotations. Approved rates are not edited:
/// cancel and create a new one.
model RateCard {
  id                    String       @id @default(uuid()) @db.Uuid
  branchId              String       @map("branch_id") @db.Uuid
  originLocationId      String       @map("origin_location_id") @db.Uuid
  destinationLocationId String       @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?    @map("load_type")
  cargoType             CargoType    @map("cargo_type")
  containerTypeCode     String?      @map("container_type_code") @db.VarChar(10)
  chargeTypeCode        String       @default("FREIGHT") @map("charge_type_code") @db.VarChar(20)
  unit                  RateUnit
  price                 Decimal      @db.Decimal(18, 4)
  minimumCharge         Decimal      @default(0) @map("minimum_charge") @db.Decimal(18, 4)
  currency              String       @db.Char(3)
  validFrom             DateTime     @map("valid_from") @db.Date
  validTo               DateTime?    @map("valid_to") @db.Date
  transitDays           Int?         @map("transit_days")
  notes                 String?
  status                RateStatus   @default(DRAFT)
  approvedById          String?      @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdById           String       @map("created_by_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  origin         Location        @relation("RateOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination    Location        @relation("RateDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  containerType  ContainerType?  @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)
  chargeType     ChargeType      @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  currencyRef    Currency        @relation(fields: [currency], references: [code], onDelete: Restrict)
  approvedBy     User?           @relation("RateApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy      User            @relation("RateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotationLines QuotationLine[]

  @@index([branchId, status])
  @@index([originLocationId, destinationLocationId, mode])
  @@map("rate_cards")
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED

  @@map("quotation_status")
}

/// Price offer to a customer (annex B section 2). Totals are computed by the service from the
/// lines, rounded once, and stored.
model Quotation {
  id                    String          @id @default(uuid()) @db.Uuid
  /// NOL-QT-2026-000001
  number                String          @unique @db.VarChar(30)
  branchId              String          @map("branch_id") @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  originLocationId      String          @map("origin_location_id") @db.Uuid
  destinationLocationId String          @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?       @map("load_type")
  cargoType             CargoType       @map("cargo_type")
  cargoDescription      String?         @map("cargo_description")
  currency              String          @db.Char(3)
  subtotal              Decimal         @default(0) @db.Decimal(18, 4)
  discountTotal         Decimal         @default(0) @map("discount_total") @db.Decimal(18, 4)
  total                 Decimal         @default(0) @db.Decimal(18, 4)
  validUntil            DateTime        @map("valid_until") @db.Date
  terms                 String?
  status                QuotationStatus @default(DRAFT)
  rejectionReason       String?         @map("rejection_reason")
  sentAt                DateTime?       @map("sent_at") @db.Timestamptz(3)
  decidedAt             DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdById           String          @map("created_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  origin      Location        @relation("QuotationOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination Location        @relation("QuotationDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  currencyRef Currency        @relation(fields: [currency], references: [code], onDelete: Restrict)
  createdBy   User            @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines       QuotationLine[]
  booking     Booking?

  @@index([branchId, status])
  @@index([customerId])
  @@map("quotations")
}

model QuotationLine {
  id             String   @id @default(uuid()) @db.Uuid
  quotationId    String   @map("quotation_id") @db.Uuid
  lineNo         Int      @map("line_no") @db.SmallInt
  chargeTypeCode String   @map("charge_type_code") @db.VarChar(20)
  description    String?
  rateCardId     String?  @map("rate_card_id") @db.Uuid
  unit           RateUnit
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 4)
  /// From the rate card: the line is never charged less than this, before discount.
  minimumCharge  Decimal  @default(0) @map("minimum_charge") @db.Decimal(18, 4)
  discount       Decimal  @default(0) @db.Decimal(18, 4)
  /// max(round(quantity * unitPrice), minimumCharge) - discount, rounded to the currency.
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 4)

  quotation  Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  rateCard   RateCard?  @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNo])
  @@map("quotation_lines")
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("booking_status")
}

/// Optional services chosen on the booking; they decide which shipment stages exist (annex B).
enum BookingService {
  MAIN_FREIGHT
  PICKUP
  WAREHOUSE
  CUSTOMS
  INLAND_TRANSPORT
  LAST_MILE

  @@map("booking_service")
}

/// A booking (annex B section 3). Created from an approved quotation (at most one booking per
/// quotation) or directly. A confirmed booking produces exactly one shipment (group 3).
model Booking {
  id                    String           @id @default(uuid()) @db.Uuid
  /// NOL-BK-2026-000001
  number                String           @unique @db.VarChar(30)
  branchId              String           @map("branch_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  quotationId           String?          @unique @map("quotation_id") @db.Uuid
  originLocationId      String           @map("origin_location_id") @db.Uuid
  destinationLocationId String           @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?        @map("load_type")
  cargoType             CargoType        @map("cargo_type")
  cargoDescription      String?          @map("cargo_description")
  services              BookingService[]
  shipperId             String?          @map("shipper_id") @db.Uuid
  consigneeId           String?          @map("consignee_id") @db.Uuid
  notifyPartyId         String?          @map("notify_party_id") @db.Uuid
  requestedDeparture    DateTime?        @map("requested_departure") @db.Date
  specialInstructions   String?          @map("special_instructions")
  status                BookingStatus    @default(DRAFT)
  cancelReason          String?          @map("cancel_reason")
  confirmedAt           DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  createdById           String           @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  origin      Location      @relation("BookingOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination Location      @relation("BookingDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  shipper     Party?        @relation("BookingShipper", fields: [shipperId], references: [id], onDelete: Restrict)
  consignee   Party?        @relation("BookingConsignee", fields: [consigneeId], references: [id], onDelete: Restrict)
  notifyParty Party?        @relation("BookingNotify", fields: [notifyPartyId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       BookingItem[]
  shipment    Shipment?

  @@index([branchId, status])
  @@index([customerId])
  @@map("bookings")
}

/// One line of cargo: containers, pallets, barrels or general cargo.
model BookingItem {
  id                String    @id @default(uuid()) @db.Uuid
  bookingId         String    @map("booking_id") @db.Uuid
  lineNo            Int       @map("line_no") @db.SmallInt
  cargoType         CargoType @map("cargo_type")
  containerTypeCode String?   @map("container_type_code") @db.VarChar(10)
  description       String?
  quantity          Int
  lengthCm          Decimal?  @map("length_cm") @db.Decimal(10, 2)
  widthCm           Decimal?  @map("width_cm") @db.Decimal(10, 2)
  heightCm          Decimal?  @map("height_cm") @db.Decimal(10, 2)
  /// Total for the line.
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(12, 3)
  /// Total for the line (CBM calculator output, or entered).
  volumeCbm         Decimal?  @map("volume_cbm") @db.Decimal(12, 4)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  containerType ContainerType? @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([bookingId, lineNo])
  @@map("booking_items")
}

// ---------------------------------------------------------------------------------------------
// Group 3: shipments, tracking events, documents (annex B section 4).
// ---------------------------------------------------------------------------------------------

/**
 * Internal shipment statuses (annex B section 4). Transitions live in shipments/state-machine.ts.
 */
enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  RECEIVED_ORIGIN_WAREHOUSE
  CONSOLIDATED
  LOADED
  DEPARTED
  IN_TRANSIT
  ARRIVED_PORT
  TRIP_SCHEDULED
  ROAD_DEPARTED
  ROAD_IN_TRANSIT
  ROAD_ARRIVED
  CUSTOMS_IN_PROGRESS
  CUSTOMS_CLEARED
  RECEIVED_DESTINATION_WAREHOUSE
  OUT_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  ON_HOLD
  CANCELLED

  @@map("shipment_status")
}

/**
 * Who recorded a status change (annex B: user / API / system).
 */
enum EventSource {
  USER
  API
  SYSTEM

  @@map("event_source")
}

enum ShipmentEventKind {
  CREATED
  STATUS
  HOLD
  RESUME
  REVERT
  CANCEL

  @@map("shipment_event_kind")
}

/**
 * One shipment per confirmed booking (annex B section 6). Inherits customer, parties, route and
 * services from the booking; parties, services and transport details can be edited afterwards.
 * Status changes go through ShipmentsService only, which writes a ShipmentEvent for each.
 */
model Shipment {
  id                    String           @id @default(uuid()) @db.Uuid
  /// NOL-SHP-2026-000001
  number                String           @unique @db.VarChar(30)
  branchId              String           @map("branch_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  originLocationId      String           @map("origin_location_id") @db.Uuid
  destinationLocationId String           @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?        @map("load_type")
  cargoType             CargoType        @map("cargo_type")
  cargoDescription      String?          @map("cargo_description")
  services              BookingService[]
  shipperId             String?          @map("shipper_id") @db.Uuid
  consigneeId           String?          @map("consignee_id") @db.Uuid
  notifyPartyId         String?          @map("notify_party_id") @db.Uuid
  status                ShipmentStatus   @default(CREATED)
  /// Set while ON_HOLD: the status a resume returns to.
  statusBeforeHold      ShipmentStatus?  @map("status_before_hold")
  holdReason            String?          @map("hold_reason")
  cancelReason          String?          @map("cancel_reason")
  /// Last location recorded on a status change (city or port; shown on public tracking).
  currentLocationId     String?          @map("current_location_id") @db.Uuid
  carrierName           String?          @map("carrier_name") @db.VarChar(200)
  vesselName            String?          @map("vessel_name") @db.VarChar(200)
  voyageNumber          String?          @map("voyage_number") @db.VarChar(50)
  /// Bill of lading (sea) or consignment note (road) number.
  blNumber              String?          @map("bl_number") @db.VarChar(50)
  etd                   DateTime?        @db.Date
  eta                   DateTime?        @db.Date
  /// Random secret in the public tracking link and QR code. Never derived from the number.
  trackingToken         String           @unique @map("tracking_token") @db.VarChar(64)
  createdById           String           @map("created_by_id") @db.Uuid
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  origin          Location            @relation("ShipmentOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination     Location            @relation("ShipmentDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  currentLocation Location?           @relation("ShipmentCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  shipper         Party?              @relation("ShipmentShipper", fields: [shipperId], references: [id], onDelete: Restrict)
  consignee       Party?              @relation("ShipmentConsignee", fields: [consigneeId], references: [id], onDelete: Restrict)
  notifyParty     Party?              @relation("ShipmentNotify", fields: [notifyPartyId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items           ShipmentItem[]
  containers      ShipmentContainer[]
  events          ShipmentEvent[]
  documents       Document[]

  @@index([branchId, status])
  @@index([customerId])
  @@map("shipments")
}

/**
 * Cargo lines, copied from the booking when the shipment is created.
 */
model ShipmentItem {
  id                String    @id @default(uuid()) @db.Uuid
  shipmentId        String    @map("shipment_id") @db.Uuid
  lineNo            Int       @map("line_no") @db.SmallInt
  cargoType         CargoType @map("cargo_type")
  containerTypeCode String?   @map("container_type_code") @db.VarChar(10)
  description       String?
  quantity          Int
  lengthCm          Decimal?  @map("length_cm") @db.Decimal(10, 2)
  widthCm           Decimal?  @map("width_cm") @db.Decimal(10, 2)
  heightCm          Decimal?  @map("height_cm") @db.Decimal(10, 2)
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(12, 3)
  volumeCbm         Decimal?  @map("volume_cbm") @db.Decimal(12, 4)

  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerType ContainerType? @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([shipmentId, lineNo])
  @@map("shipment_items")
}

/**
 * A container carrying (part of) the shipment: number, seal and type.
 */
model ShipmentContainer {
  id                String   @id @default(uuid()) @db.Uuid
  shipmentId        String   @map("shipment_id") @db.Uuid
  /// ISO 6346, e.g. MSCU1234565 (owner code, serial, check digit).
  containerNumber   String   @map("container_number") @db.VarChar(11)
  sealNumber        String?  @map("seal_number") @db.VarChar(30)
  containerTypeCode String   @map("container_type_code") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerType ContainerType @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([shipmentId, containerNumber])
  @@map("shipment_containers")
}

/**
 * Tracking history: one row per status change, hold, resume, revert or cancellation, with time,
 * branch, location, user, source and note (annex B section 4). Rows are only ever inserted; the
 * id orders them.
 */
model ShipmentEvent {
  id         BigInt            @id @default(autoincrement())
  shipmentId String            @map("shipment_id") @db.Uuid
  kind       ShipmentEventKind
  /// The shipment's status after this event.
  status     ShipmentStatus
  fromStatus ShipmentStatus?   @map("from_status")
  /// When it happened (may be entered after the fact); the row's id gives the recording order.
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(3)
  branchId   String            @map("branch_id") @db.Uuid
  locationId String?           @map("location_id") @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  source     EventSource
  note       String?
  /// Mandatory for hold, revert and cancel.
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([shipmentId, id])
  @@map("shipment_events")
}

/**
 * BL, commercial invoice, packing list, customs, POD, photo... Master data the client extends.
 */
model DocumentType {
  code      String   @id @db.VarChar(30)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  documents Document[]

  @@map("document_types")
}

/**
 * A file attached to a shipment. The bytes live in document_contents so listing documents never
 * loads them. Deleting is soft (deletedAt), so the record of who uploaded what remains.
 */
model Document {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  shipmentId   String    @map("shipment_id") @db.Uuid
  typeCode     String    @map("type_code") @db.VarChar(30)
  /// Original file name, for display and download only.
  fileName     String    @map("file_name") @db.VarChar(255)
  /// Detected from the file's content, never taken from the upload headers.
  contentType  String    @map("content_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  sha256       String    @db.Char(64)
  note         String?
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  branch     Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment   Shipment         @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type       DocumentType     @relation(fields: [typeCode], references: [code], onDelete: Restrict)
  uploadedBy User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  User?            @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  content    DocumentContent?

  @@index([shipmentId])
  @@index([branchId])
  @@map("documents")
}

model DocumentContent {
  documentId String @id @map("document_id") @db.Uuid
  data       Bytes

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_contents")
}
