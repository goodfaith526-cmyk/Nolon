// Database schema. Rules (see AGENTS.md):
// - Money columns are Decimal (@db.Decimal(18, 4)), never Float.
// - Branch-owned tables carry branch_id and every query filters on it.
// - Immutability of posted journal entries is enforced by triggers in raw SQL migrations.
// - Every migration is reviewed by a human before merge.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Key/value system settings. Foundation table only: business tables arrive with their modules.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

/// Operating branch (DXB, JED, PTS, ATB, KRT). Root of branch scoping: branch-owned tables
/// reference it. Codes must match BRANCH_CODES in @nolon/shared.
model Branch {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(10)
  nameEn          String   @map("name_en")
  nameAr          String   @map("name_ar")
  /// ISO 3166-1 alpha-2.
  countryCode     String   @map("country_code") @db.Char(2)
  city            String
  /// ISO 4217 code; must exist in the currencies master.
  defaultCurrency String   @map("default_currency") @db.Char(3)
  currency        Currency @relation(fields: [defaultCurrency], references: [code], onUpdate: Restrict, onDelete: Restrict)
  /// IANA time zone, e.g. Asia/Dubai.
  timezone        String
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users           UserBranch[]
  customers       Customer[]
  rateCards       RateCard[]
  quotations      Quotation[]
  bookings        Booking[]
  shipments       Shipment[]
  sharedShipments ShipmentBranch[]
  shipmentEvents  ShipmentEvent[]
  documents       Document[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  journalLines    JournalLine[]
  invoices        CustomerInvoice[]
  receipts        Receipt[]

  warehouses         Warehouse[]
  storageLocations   StorageLocation[]
  warehouseMovements WarehouseMovement[]
  movementPhotos     WarehouseMovementPhoto[]
  customsClearances  CustomsClearance[]
  customsFees        CustomsFee[]

  vehicles     Vehicle[]
  drivers      Driver[]
  trips        Trip[]
  tripLinks    TripShipment[]
  tripExpenses TripExpense[]
  pods         ProofOfDelivery[]
  podPhotos    PodPhoto[]

  creditNotes      CreditNote[]
  supplierBills    SupplierBill[]
  supplierPayments SupplierPayment[]
  expenses         Expense[]

  @@map("branches")
}

/// Currency master. Users add currencies here (no code change or deploy). The initial set
/// (USD, AED, SAR, SDG, EUR) is inserted by the migration that creates the table, because
/// branches reference it in every environment. Deactivate a currency; never delete one that is
/// in use (foreign keys restrict it).
model Currency {
  /// ISO 4217, e.g. SDG.
  code          String   @id @db.Char(3)
  nameEn        String   @map("name_en")
  nameAr        String   @map("name_ar")
  symbol        String?  @db.VarChar(8)
  /// Minor units used when rounding amounts in this currency (ISO 4217 exponent, e.g. 2).
  decimalPlaces Int      @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches             Branch[]
  customersPreferred   Customer[]        @relation("CustomerPreferredCurrency")
  customersCreditLimit Customer[]        @relation("CustomerCreditLimitCurrency")
  rateCards            RateCard[]
  quotations           Quotation[]
  accounts             Account[]
  fxRates              FxRate[]
  journalLines         JournalLine[]
  invoices             CustomerInvoice[]
  receipts             Receipt[]
  customsFees          CustomsFee[]
  trips                Trip[]
  tripExpenses         TripExpense[]
  supplierBills        SupplierBill[]
  supplierPayments     SupplierPayment[]
  expenses             Expense[]

  @@map("currencies")
}

/// Fixed roles from the permissions annex (02a). Each role's permissions live in code
/// (ROLE_PERMISSIONS in @nolon/shared), not in the database: there is no custom role editor.
enum Role {
  ADMINISTRATOR
  MANAGEMENT
  BRANCH_MANAGER
  SALES
  OPERATIONS
  FINANCE
  WAREHOUSE
  CUSTOMS
  DRIVER

  @@map("role")
}

/// Staff user who signs in to the web app. A user can hold several roles and several branches;
/// permissions add up across roles.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; the sign-in lookup normalizes the same way.
  email           String    @unique @db.VarChar(254)
  fullName        String    @map("full_name") @db.VarChar(200)
  /// scrypt hash in the form scrypt$N$r$p$salt$hash (base64). Never the plain password.
  passwordHash    String    @map("password_hash")
  /// "ar" or "en", one of LOCALES in @nolon/shared.
  preferredLocale String    @default("ar") @map("preferred_locale") @db.VarChar(5)
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles    UserRole[]
  branches UserBranch[]
  sessions Session[]

  customersCreated  Customer[]        @relation("CustomerCreatedBy")
  ratesCreated      RateCard[]        @relation("RateCreatedBy")
  ratesApproved     RateCard[]        @relation("RateApprovedBy")
  quotationsCreated Quotation[]       @relation("QuotationCreatedBy")
  bookingsCreated   Booking[]         @relation("BookingCreatedBy")
  shipmentsCreated  Shipment[]        @relation("ShipmentCreatedBy")
  shipmentEvents    ShipmentEvent[]
  documentsUploaded Document[]        @relation("DocumentUploadedBy")
  documentsDeleted  Document[]        @relation("DocumentDeletedBy")
  periodsClosed     FiscalPeriod[]    @relation("PeriodClosedBy")
  fxRatesCreated    FxRate[]          @relation("FxRateCreatedBy")
  journalsCreated   JournalEntry[]    @relation("JournalCreatedBy")
  journalsPosted    JournalEntry[]    @relation("JournalPostedBy")
  invoicesCreated   CustomerInvoice[] @relation("InvoiceCreatedBy")
  invoicesApproved  CustomerInvoice[] @relation("InvoiceApprovedBy")
  receiptsCreated   Receipt[]         @relation("ReceiptCreatedBy")
  receiptsCancelled Receipt[]         @relation("ReceiptCancelledBy")

  warehouseMovements WarehouseMovement[] @relation("WarehouseMovementCreatedBy")
  customsUpdated     CustomsClearance[]  @relation("CustomsUpdatedBy")
  customsFeesCreated CustomsFee[]        @relation("CustomsFeeCreatedBy")

  driverProfile         Driver?
  tripsCreated          Trip[]            @relation("TripCreatedBy")
  tripExpensesCreated   TripExpense[]     @relation("TripExpenseCreatedBy")
  tripExpensesCancelled TripExpense[]     @relation("TripExpenseCancelledBy")
  podsCreated           ProofOfDelivery[] @relation("PodCreatedBy")

  creditNotesCreated       CreditNote[]      @relation("CreditNoteCreatedBy")
  creditNotesApproved      CreditNote[]      @relation("CreditNoteApprovedBy")
  creditNotesCancelled     CreditNote[]      @relation("CreditNoteCancelledBy")
  suppliersCreated         Supplier[]        @relation("SupplierCreatedBy")
  supplierBillsCreated     SupplierBill[]    @relation("SupplierBillCreatedBy")
  supplierBillsApproved    SupplierBill[]    @relation("SupplierBillApprovedBy")
  supplierBillsCancelled   SupplierBill[]    @relation("SupplierBillCancelledBy")
  supplierPaymentsCreated  SupplierPayment[] @relation("SupplierPaymentCreatedBy")
  supplierPaymentsCanceled SupplierPayment[] @relation("SupplierPaymentCancelledBy")
  expensesCreated          Expense[]         @relation("ExpenseCreatedBy")
  expensesApproved         Expense[]         @relation("ExpenseApprovedBy")
  expensesCancelled        Expense[]         @relation("ExpenseCancelledBy")

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

/// Branches a user may work in. Administrator and Management see every branch through their
/// role; every other role sees only the branches listed here.
model UserBranch {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// Server-side sign-in session. The browser holds a random token in an httpOnly cookie; only its
/// SHA-256 hash is stored, so a database leak does not leak usable sessions. Sign-out sets
/// revokedAt; expired and revoked sessions are rejected.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the cookie token, hex.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------------------------
// Group 2: master data, customers, rates, quotations, bookings.
// Branch-owned tables carry branch_id; services filter on the user's allowed branches.
// Currency columns reference the currency master; services check the currency is active.
// ---------------------------------------------------------------------------------------------

/// Per-document running numbers (e.g. NOL-QT-2026-000001). Incremented inside the transaction that
/// creates the document, so numbers are unique and gap-free under concurrency.
model NumberSequence {
  docType   String @map("doc_type") @db.VarChar(30)
  /// "2026" for yearly sequences, "" for never-resetting ones.
  periodKey String @default("") @map("period_key") @db.VarChar(10)
  nextValue BigInt @default(1) @map("next_value")

  @@id([docType, periodKey])
  @@map("number_sequences")
}

enum LocationKind {
  PORT
  CITY
  BORDER
  OTHER

  @@map("location_kind")
}

/// Ports, cities and border points used in routes. Master data the client extends.
model Location {
  id          String       @id @default(uuid()) @db.Uuid
  /// UN/LOCODE where one exists (AEJEA, SAJED, SDPZU), otherwise an internal code.
  code        String       @unique @db.VarChar(10)
  kind        LocationKind
  nameEn      String       @map("name_en")
  nameAr      String       @map("name_ar")
  /// ISO 3166-1 alpha-2.
  countryCode String       @map("country_code") @db.Char(2)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  ratesFrom      RateCard[]      @relation("RateOrigin")
  ratesTo        RateCard[]      @relation("RateDestination")
  quotationsFrom Quotation[]     @relation("QuotationOrigin")
  quotationsTo   Quotation[]     @relation("QuotationDestination")
  bookingsFrom   Booking[]       @relation("BookingOrigin")
  bookingsTo     Booking[]       @relation("BookingDestination")
  shipmentsFrom  Shipment[]      @relation("ShipmentOrigin")
  shipmentsTo    Shipment[]      @relation("ShipmentDestination")
  shipmentsAt    Shipment[]      @relation("ShipmentCurrentLocation")
  events         ShipmentEvent[]
  tripsFrom      Trip[]          @relation("TripOrigin")
  tripsTo        Trip[]          @relation("TripDestination")

  @@map("locations")
}

/// 20GP, 40GP, 40HC, OTHER... Master data the client extends.
model ContainerType {
  code      String   @id @db.VarChar(10)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rates              RateCard[]
  bookingItems       BookingItem[]
  shipmentItems      ShipmentItem[]
  shipmentContainers ShipmentContainer[]

  @@map("container_types")
}

/// Freight, THC, documentation, customs... The kinds of charge on a rate or quotation line.
model ChargeType {
  code      String   @id @db.VarChar(20)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rates          RateCard[]
  quotationLines QuotationLine[]
  posting        ChargeTypePosting?
  invoiceLines   CustomerInvoiceLine[]
  billLines      SupplierBillLine[]

  @@map("charge_types")
}

enum ShippingMode {
  SEA
  ROAD

  @@map("shipping_mode")
}

enum LoadType {
  FCL
  LCL

  @@map("load_type")
}

enum CargoType {
  CONTAINER
  PALLET
  BARREL
  GENERAL

  @@map("cargo_type")
}

enum RateUnit {
  PER_CONTAINER
  PER_CBM
  PER_KG
  PER_PALLET
  PER_BARREL
  PER_PIECE
  PER_SHIPMENT

  @@map("rate_unit")
}

enum CustomerKind {
  INDIVIDUAL
  COMPANY

  @@map("customer_kind")
}

/// A NOLON customer. Branch-owned: staff see the customers of their branches only.
model Customer {
  id                  String       @id @default(uuid()) @db.Uuid
  /// NOL-CUS-000001
  number              String       @unique @db.VarChar(30)
  branchId            String       @map("branch_id") @db.Uuid
  kind                CustomerKind
  name                String       @db.VarChar(200)
  companyName         String?      @map("company_name") @db.VarChar(200)
  /// E.164, e.g. +249912345678.
  phone               String       @db.VarChar(20)
  whatsapp            String?      @db.VarChar(20)
  email               String?      @db.VarChar(254)
  countryCode         String?      @map("country_code") @db.Char(2)
  city                String?      @db.VarChar(100)
  address             String?
  taxNumber           String?      @map("tax_number") @db.VarChar(50)
  preferredCurrency   String?      @map("preferred_currency") @db.Char(3)
  preferredLocale     String       @default("ar") @map("preferred_locale") @db.VarChar(5)
  paymentTermsDays    Int          @default(0) @map("payment_terms_days")
  creditLimit         Decimal?     @map("credit_limit") @db.Decimal(18, 4)
  creditLimitCurrency String?      @map("credit_limit_currency") @db.Char(3)
  notes               String?
  isActive            Boolean      @default(true) @map("is_active")
  createdById         String       @map("created_by_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  preferredCurrencyRef   Currency?         @relation("CustomerPreferredCurrency", fields: [preferredCurrency], references: [code], onDelete: Restrict)
  creditLimitCurrencyRef Currency?         @relation("CustomerCreditLimitCurrency", fields: [creditLimitCurrency], references: [code], onDelete: Restrict)
  createdBy              User              @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  contacts               CustomerContact[]
  parties                Party[]
  quotations             Quotation[]
  bookings               Booking[]
  shipments              Shipment[]
  journalLines           JournalLine[]
  invoices               CustomerInvoice[]
  receipts               Receipt[]
  creditNotes            CreditNote[]

  @@index([branchId])
  @@index([phone])
  @@map("customers")
}

/// A person authorized to act for a customer: inquire, receive cargo or receive documents.
model CustomerContact {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  name                String   @db.VarChar(200)
  position            String?  @db.VarChar(100)
  phone               String   @db.VarChar(20)
  email               String?  @db.VarChar(254)
  idNumber            String?  @map("id_number") @db.VarChar(50)
  canInquire          Boolean  @default(true) @map("can_inquire")
  canReceiveCargo     Boolean  @default(false) @map("can_receive_cargo")
  canReceiveDocuments Boolean  @default(false) @map("can_receive_documents")
  isPrimary           Boolean  @default(false) @map("is_primary")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([phone])
  @@map("customer_contacts")
}

/// Shipper / consignee / notify party. Separate from customers (scope 6); each entry belongs to
/// one customer's address book.
model Party {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  name        String   @db.VarChar(200)
  companyName String?  @map("company_name") @db.VarChar(200)
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(254)
  countryCode String?  @map("country_code") @db.Char(2)
  city        String?  @db.VarChar(100)
  address     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer           Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  bookingsShipper    Booking[]  @relation("BookingShipper")
  bookingsConsignee  Booking[]  @relation("BookingConsignee")
  bookingsNotify     Booking[]  @relation("BookingNotify")
  shipmentsShipper   Shipment[] @relation("ShipmentShipper")
  shipmentsConsignee Shipment[] @relation("ShipmentConsignee")
  shipmentsNotify    Shipment[] @relation("ShipmentNotify")

  @@index([customerId])
  @@map("parties")
}

enum RateStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("rate_status")
}

/// A selling rate for a route. Sales create and edit drafts; a Branch Manager (or anyone with
/// rates:approve) approves. Only approved rates feed quotations. Approved rates are not edited:
/// cancel and create a new one.
model RateCard {
  id                    String       @id @default(uuid()) @db.Uuid
  branchId              String       @map("branch_id") @db.Uuid
  originLocationId      String       @map("origin_location_id") @db.Uuid
  destinationLocationId String       @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?    @map("load_type")
  cargoType             CargoType    @map("cargo_type")
  containerTypeCode     String?      @map("container_type_code") @db.VarChar(10)
  chargeTypeCode        String       @default("FREIGHT") @map("charge_type_code") @db.VarChar(20)
  unit                  RateUnit
  price                 Decimal      @db.Decimal(18, 4)
  minimumCharge         Decimal      @default(0) @map("minimum_charge") @db.Decimal(18, 4)
  currency              String       @db.Char(3)
  validFrom             DateTime     @map("valid_from") @db.Date
  validTo               DateTime?    @map("valid_to") @db.Date
  transitDays           Int?         @map("transit_days")
  notes                 String?
  status                RateStatus   @default(DRAFT)
  approvedById          String?      @map("approved_by_id") @db.Uuid
  approvedAt            DateTime?    @map("approved_at") @db.Timestamptz(3)
  createdById           String       @map("created_by_id") @db.Uuid
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  origin         Location        @relation("RateOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination    Location        @relation("RateDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  containerType  ContainerType?  @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)
  chargeType     ChargeType      @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  currencyRef    Currency        @relation(fields: [currency], references: [code], onDelete: Restrict)
  approvedBy     User?           @relation("RateApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy      User            @relation("RateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  quotationLines QuotationLine[]

  @@index([branchId, status])
  @@index([originLocationId, destinationLocationId, mode])
  @@map("rate_cards")
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED

  @@map("quotation_status")
}

/// Price offer to a customer (annex B section 2). Totals are computed by the service from the
/// lines, rounded once, and stored.
model Quotation {
  id                    String          @id @default(uuid()) @db.Uuid
  /// NOL-QT-2026-000001
  number                String          @unique @db.VarChar(30)
  branchId              String          @map("branch_id") @db.Uuid
  customerId            String          @map("customer_id") @db.Uuid
  originLocationId      String          @map("origin_location_id") @db.Uuid
  destinationLocationId String          @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?       @map("load_type")
  cargoType             CargoType       @map("cargo_type")
  cargoDescription      String?         @map("cargo_description")
  currency              String          @db.Char(3)
  subtotal              Decimal         @default(0) @db.Decimal(18, 4)
  discountTotal         Decimal         @default(0) @map("discount_total") @db.Decimal(18, 4)
  total                 Decimal         @default(0) @db.Decimal(18, 4)
  validUntil            DateTime        @map("valid_until") @db.Date
  terms                 String?
  status                QuotationStatus @default(DRAFT)
  rejectionReason       String?         @map("rejection_reason")
  sentAt                DateTime?       @map("sent_at") @db.Timestamptz(3)
  decidedAt             DateTime?       @map("decided_at") @db.Timestamptz(3)
  createdById           String          @map("created_by_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  origin      Location        @relation("QuotationOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination Location        @relation("QuotationDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  currencyRef Currency        @relation(fields: [currency], references: [code], onDelete: Restrict)
  createdBy   User            @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines       QuotationLine[]
  booking     Booking?

  @@index([branchId, status])
  @@index([customerId])
  @@map("quotations")
}

model QuotationLine {
  id             String   @id @default(uuid()) @db.Uuid
  quotationId    String   @map("quotation_id") @db.Uuid
  lineNo         Int      @map("line_no") @db.SmallInt
  chargeTypeCode String   @map("charge_type_code") @db.VarChar(20)
  description    String?
  rateCardId     String?  @map("rate_card_id") @db.Uuid
  unit           RateUnit
  quantity       Decimal  @db.Decimal(18, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 4)
  /// From the rate card: the line is never charged less than this, before discount.
  minimumCharge  Decimal  @default(0) @map("minimum_charge") @db.Decimal(18, 4)
  discount       Decimal  @default(0) @db.Decimal(18, 4)
  /// max(round(quantity * unitPrice), minimumCharge) - discount, rounded to the currency.
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 4)

  quotation  Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  chargeType ChargeType @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  rateCard   RateCard?  @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  @@unique([quotationId, lineNo])
  @@map("quotation_lines")
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED

  @@map("booking_status")
}

/// Optional services chosen on the booking; they decide which shipment stages exist (annex B).
enum BookingService {
  MAIN_FREIGHT
  PICKUP
  WAREHOUSE
  CUSTOMS
  INLAND_TRANSPORT
  LAST_MILE

  @@map("booking_service")
}

/// A booking (annex B section 3). Created from an approved quotation (at most one booking per
/// quotation) or directly. A confirmed booking produces exactly one shipment (group 3).
model Booking {
  id                    String           @id @default(uuid()) @db.Uuid
  /// NOL-BK-2026-000001
  number                String           @unique @db.VarChar(30)
  branchId              String           @map("branch_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  quotationId           String?          @unique @map("quotation_id") @db.Uuid
  originLocationId      String           @map("origin_location_id") @db.Uuid
  destinationLocationId String           @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?        @map("load_type")
  cargoType             CargoType        @map("cargo_type")
  cargoDescription      String?          @map("cargo_description")
  services              BookingService[]
  shipperId             String?          @map("shipper_id") @db.Uuid
  consigneeId           String?          @map("consignee_id") @db.Uuid
  notifyPartyId         String?          @map("notify_party_id") @db.Uuid
  requestedDeparture    DateTime?        @map("requested_departure") @db.Date
  specialInstructions   String?          @map("special_instructions")
  status                BookingStatus    @default(DRAFT)
  cancelReason          String?          @map("cancel_reason")
  confirmedAt           DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  createdById           String           @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation   Quotation?    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  origin      Location      @relation("BookingOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination Location      @relation("BookingDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  shipper     Party?        @relation("BookingShipper", fields: [shipperId], references: [id], onDelete: Restrict)
  consignee   Party?        @relation("BookingConsignee", fields: [consigneeId], references: [id], onDelete: Restrict)
  notifyParty Party?        @relation("BookingNotify", fields: [notifyPartyId], references: [id], onDelete: Restrict)
  createdBy   User          @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       BookingItem[]
  shipment    Shipment?

  @@index([branchId, status])
  @@index([customerId])
  @@map("bookings")
}

/// One line of cargo: containers, pallets, barrels or general cargo.
model BookingItem {
  id                String    @id @default(uuid()) @db.Uuid
  bookingId         String    @map("booking_id") @db.Uuid
  lineNo            Int       @map("line_no") @db.SmallInt
  cargoType         CargoType @map("cargo_type")
  containerTypeCode String?   @map("container_type_code") @db.VarChar(10)
  description       String?
  quantity          Int
  lengthCm          Decimal?  @map("length_cm") @db.Decimal(10, 2)
  widthCm           Decimal?  @map("width_cm") @db.Decimal(10, 2)
  heightCm          Decimal?  @map("height_cm") @db.Decimal(10, 2)
  /// Total for the line.
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(12, 3)
  /// Total for the line (CBM calculator output, or entered).
  volumeCbm         Decimal?  @map("volume_cbm") @db.Decimal(12, 4)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  containerType ContainerType? @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([bookingId, lineNo])
  @@map("booking_items")
}

// ---------------------------------------------------------------------------------------------
// Group 3: shipments, tracking events, documents (annex B section 4).
// ---------------------------------------------------------------------------------------------

/**
 * Internal shipment statuses (annex B section 4). Transitions live in shipments/state-machine.ts.
 */
enum ShipmentStatus {
  CREATED
  PICKUP_SCHEDULED
  RECEIVED_ORIGIN_WAREHOUSE
  CONSOLIDATED
  LOADED
  DEPARTED
  IN_TRANSIT
  ARRIVED_PORT
  TRIP_SCHEDULED
  ROAD_DEPARTED
  ROAD_IN_TRANSIT
  ROAD_ARRIVED
  CUSTOMS_IN_PROGRESS
  CUSTOMS_CLEARED
  RECEIVED_DESTINATION_WAREHOUSE
  OUT_FOR_DELIVERY
  PARTIALLY_DELIVERED
  DELIVERED
  CLOSED
  ON_HOLD
  CANCELLED

  @@map("shipment_status")
}

/**
 * Who recorded a status change (annex B: user / API / system).
 */
enum EventSource {
  USER
  API
  SYSTEM

  @@map("event_source")
}

enum ShipmentEventKind {
  CREATED
  STATUS
  HOLD
  RESUME
  REVERT
  CANCEL

  @@map("shipment_event_kind")
}

/**
 * One shipment per confirmed booking (annex B section 6). Inherits customer, parties, route and
 * services from the booking; parties, services and transport details can be edited afterwards.
 * Status changes go through ShipmentsService only, which writes a ShipmentEvent for each.
 */
model Shipment {
  id                    String           @id @default(uuid()) @db.Uuid
  /// NOL-SHP-2026-000001
  number                String           @unique @db.VarChar(30)
  branchId              String           @map("branch_id") @db.Uuid
  customerId            String           @map("customer_id") @db.Uuid
  bookingId             String           @unique @map("booking_id") @db.Uuid
  originLocationId      String           @map("origin_location_id") @db.Uuid
  destinationLocationId String           @map("destination_location_id") @db.Uuid
  mode                  ShippingMode
  loadType              LoadType?        @map("load_type")
  cargoType             CargoType        @map("cargo_type")
  cargoDescription      String?          @map("cargo_description")
  services              BookingService[]
  shipperId             String?          @map("shipper_id") @db.Uuid
  consigneeId           String?          @map("consignee_id") @db.Uuid
  notifyPartyId         String?          @map("notify_party_id") @db.Uuid
  status                ShipmentStatus   @default(CREATED)
  /// Set while ON_HOLD: the status a resume returns to.
  statusBeforeHold      ShipmentStatus?  @map("status_before_hold")
  holdReason            String?          @map("hold_reason")
  cancelReason          String?          @map("cancel_reason")
  /// Last location recorded on a status change (city or port; shown on public tracking).
  currentLocationId     String?          @map("current_location_id") @db.Uuid
  carrierName           String?          @map("carrier_name") @db.VarChar(200)
  vesselName            String?          @map("vessel_name") @db.VarChar(200)
  voyageNumber          String?          @map("voyage_number") @db.VarChar(50)
  /// Bill of lading (sea) or consignment note (road) number.
  blNumber              String?          @map("bl_number") @db.VarChar(50)
  etd                   DateTime?        @db.Date
  eta                   DateTime?        @db.Date
  /// Random secret in the public tracking link and QR code. Never derived from the number.
  trackingToken         String           @unique @map("tracking_token") @db.VarChar(64)
  createdById           String           @map("created_by_id") @db.Uuid
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking         Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  origin          Location            @relation("ShipmentOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination     Location            @relation("ShipmentDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  currentLocation Location?           @relation("ShipmentCurrentLocation", fields: [currentLocationId], references: [id], onDelete: Restrict)
  shipper         Party?              @relation("ShipmentShipper", fields: [shipperId], references: [id], onDelete: Restrict)
  consignee       Party?              @relation("ShipmentConsignee", fields: [consigneeId], references: [id], onDelete: Restrict)
  notifyParty     Party?              @relation("ShipmentNotify", fields: [notifyPartyId], references: [id], onDelete: Restrict)
  createdBy       User                @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items           ShipmentItem[]
  containers      ShipmentContainer[]
  events          ShipmentEvent[]
  documents       Document[]
  journalLines    JournalLine[]
  invoices        CustomerInvoice[]
  movements       WarehouseMovement[]
  customs         CustomsClearance?
  customsFees     CustomsFee[]
  tripLinks       TripShipment[]
  pods            ProofOfDelivery[]
  billLines       SupplierBillLine[]
  sharedBranches  ShipmentBranch[]

  @@index([branchId, status])
  @@index([customerId])
  @@map("shipments")
}

/**
 * Other branches that work on a shipment besides the one that owns it (annex A: a DXB → KRT
 * shipment is visible to both branches; a transit branch such as PTS may join too). Their users
 * see the shipment and record its operations (goods receipt, customs, trips, POD); billing stays
 * with the owning branch. Chosen by the owning branch on the shipment page.
 */
model ShipmentBranch {
  shipmentId String   @map("shipment_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([shipmentId, branchId])
  @@index([branchId])
  @@map("shipment_branches")
}

/**
 * Cargo lines, copied from the booking when the shipment is created.
 */
model ShipmentItem {
  id                String    @id @default(uuid()) @db.Uuid
  shipmentId        String    @map("shipment_id") @db.Uuid
  lineNo            Int       @map("line_no") @db.SmallInt
  cargoType         CargoType @map("cargo_type")
  containerTypeCode String?   @map("container_type_code") @db.VarChar(10)
  description       String?
  quantity          Int
  lengthCm          Decimal?  @map("length_cm") @db.Decimal(10, 2)
  widthCm           Decimal?  @map("width_cm") @db.Decimal(10, 2)
  heightCm          Decimal?  @map("height_cm") @db.Decimal(10, 2)
  weightKg          Decimal?  @map("weight_kg") @db.Decimal(12, 3)
  volumeCbm         Decimal?  @map("volume_cbm") @db.Decimal(12, 4)

  shipment      Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerType ContainerType? @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([shipmentId, lineNo])
  @@map("shipment_items")
}

/**
 * A container carrying (part of) the shipment: number, seal and type.
 */
model ShipmentContainer {
  id                String   @id @default(uuid()) @db.Uuid
  shipmentId        String   @map("shipment_id") @db.Uuid
  /// ISO 6346, e.g. MSCU1234565 (owner code, serial, check digit).
  containerNumber   String   @map("container_number") @db.VarChar(11)
  sealNumber        String?  @map("seal_number") @db.VarChar(30)
  containerTypeCode String   @map("container_type_code") @db.VarChar(10)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  containerType ContainerType @relation(fields: [containerTypeCode], references: [code], onDelete: Restrict)

  @@unique([shipmentId, containerNumber])
  @@map("shipment_containers")
}

/**
 * Tracking history: one row per status change, hold, resume, revert or cancellation, with time,
 * branch, location, user, source and note (annex B section 4). Rows are only ever inserted; the
 * id orders them.
 */
model ShipmentEvent {
  id         BigInt            @id @default(autoincrement())
  shipmentId String            @map("shipment_id") @db.Uuid
  kind       ShipmentEventKind
  /// The shipment's status after this event.
  status     ShipmentStatus
  fromStatus ShipmentStatus?   @map("from_status")
  /// When it happened (may be entered after the fact); the row's id gives the recording order.
  occurredAt DateTime          @map("occurred_at") @db.Timestamptz(3)
  branchId   String            @map("branch_id") @db.Uuid
  locationId String?           @map("location_id") @db.Uuid
  userId     String?           @map("user_id") @db.Uuid
  source     EventSource
  note       String?
  /// Mandatory for hold, revert and cancel.
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  location Location? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user     User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([shipmentId, id])
  @@map("shipment_events")
}

/**
 * BL, commercial invoice, packing list, customs, POD, photo... Master data the client extends.
 */
model DocumentType {
  code      String   @id @db.VarChar(30)
  nameEn    String   @map("name_en")
  nameAr    String   @map("name_ar")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  documents Document[]

  @@map("document_types")
}

/**
 * A file attached to a shipment. The bytes live in document_contents so listing documents never
 * loads them. Deleting is soft (deletedAt), so the record of who uploaded what remains.
 */
model Document {
  id           String    @id @default(uuid()) @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  shipmentId   String    @map("shipment_id") @db.Uuid
  typeCode     String    @map("type_code") @db.VarChar(30)
  /// Original file name, for display and download only.
  fileName     String    @map("file_name") @db.VarChar(255)
  /// Detected from the file's content, never taken from the upload headers.
  contentType  String    @map("content_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  sha256       String    @db.Char(64)
  note         String?
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById  String?   @map("deleted_by_id") @db.Uuid

  branch     Branch                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment   Shipment                @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  type       DocumentType            @relation(fields: [typeCode], references: [code], onDelete: Restrict)
  uploadedBy User                    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy  User?                   @relation("DocumentDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  content    DocumentContent?
  movement   WarehouseMovementPhoto?
  podSigned  ProofOfDelivery?        @relation("PodSignature")
  podPhoto   PodPhoto?

  @@index([shipmentId])
  @@index([branchId])
  @@map("documents")
}

model DocumentContent {
  documentId String @id @map("document_id") @db.Uuid
  data       Bytes

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_contents")
}

// -------------------------------------------------------------------------------------------------
// Accounting (scope section 13, annex C). Amounts are kept in the document currency and in USD,
// the reporting currency. Posted journal entries are immutable: triggers in the migration
// 20261003181158_accounting_invoices_receipts reject any change to a posted entry or its lines.
// -------------------------------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@map("account_type")
}

/// Chart of accounts. Header accounts (isPostable false) group others; only postable accounts
/// take journal lines. Cash and bank accounts (isCash) hold one currency and may belong to one
/// branch. Deactivate an account; never delete one that has lines (foreign keys restrict it).
model Account {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(20)
  nameEn     String      @map("name_en") @db.VarChar(200)
  nameAr     String      @map("name_ar") @db.VarChar(200)
  type       AccountType
  parentId   String?     @map("parent_id") @db.Uuid
  isPostable Boolean     @default(true) @map("is_postable")
  isCash     Boolean     @default(false) @map("is_cash")
  /// Cash and bank accounts only: the one currency the account holds.
  currency   String?     @db.Char(3)
  /// Cash and bank accounts only: the branch that uses it (null: any branch).
  branchId   String?     @map("branch_id") @db.Uuid
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent       Account?            @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Account[]           @relation("AccountTree")
  currencyRef  Currency?           @relation(fields: [currency], references: [code], onDelete: Restrict)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  mappings     AccountMapping[]
  chargeTypes  ChargeTypePosting[] @relation("ChargeTypeRevenue")
  journalLines JournalLine[]
  receipts     Receipt[]
  invoices     CustomerInvoice[]   @relation("InvoiceReceivable")
  tripExpenses TripExpense[]

  costChargeTypes   ChargeTypePosting[] @relation("ChargeTypeCost")
  supplierBills     SupplierBill[]      @relation("BillPayable")
  supplierPayments  SupplierPayment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]

  @@map("accounts")
}

/// The accounts the automatic entries post to (annex C section 4). The accountant changes the
/// mapping from the settings; the code only knows the roles.
enum PostingRole {
  RECEIVABLE
  PAYABLE
  CUSTOMER_ADVANCES
  DEFAULT_REVENUE
  DEFAULT_COST
  /// Trip costs (annex C rules 10, 11 and the difference of 11a).
  TRANSPORT_COST
  REIMBURSABLE
  CONSOLIDATION_CLEARING
  ACCRUED_TRANSPORT
  FX_GAIN
  FX_LOSS
  ROUNDING
  OPENING_EQUITY

  @@map("posting_role")
}

model AccountMapping {
  role      PostingRole @id
  accountId String      @map("account_id") @db.Uuid
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@map("account_mappings")
}

/// Revenue account of each charge type on a customer invoice (annex C rule 1), and cost account of
/// the same charge on a supplier bill (rule 7). Reimbursable charges (duties paid for the customer)
/// post to the REIMBURSABLE clearing account on both sides (rules 2 and 8). A charge type with no
/// row, or no account set, posts to DEFAULT_REVENUE and DEFAULT_COST.
model ChargeTypePosting {
  chargeTypeCode   String   @id @map("charge_type_code") @db.VarChar(20)
  revenueAccountId String?  @map("revenue_account_id") @db.Uuid
  costAccountId    String?  @map("cost_account_id") @db.Uuid
  isReimbursable   Boolean  @default(false) @map("is_reimbursable")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  chargeType     ChargeType @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  revenueAccount Account?   @relation("ChargeTypeRevenue", fields: [revenueAccountId], references: [id], onDelete: Restrict)
  costAccount    Account?   @relation("ChargeTypeCost", fields: [costAccountId], references: [id], onDelete: Restrict)

  @@map("charge_type_postings")
}

enum PeriodStatus {
  OPEN
  CLOSED

  @@map("period_status")
}

/// Monthly accounting period. Created on first use; nothing posts into a closed period.
model FiscalPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  year       Int          @db.SmallInt
  month      Int          @db.SmallInt
  startDate  DateTime     @map("start_date") @db.Date
  endDate    DateTime     @map("end_date") @db.Date
  status     PeriodStatus @default(OPEN)
  closedAt   DateTime?    @map("closed_at") @db.Timestamptz(3)
  closedById String?      @map("closed_by_id") @db.Uuid

  closedBy User?          @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  entries  JournalEntry[]

  @@unique([year, month])
  @@map("fiscal_periods")
}

/// Daily exchange rate: units of the currency per 1 USD (e.g. SDG 600). USD itself has no row.
model FxRate {
  id          String   @id @default(uuid()) @db.Uuid
  currency    String   @db.Char(3)
  rateDate    DateTime @map("rate_date") @db.Date
  rate        Decimal  @db.Decimal(18, 8)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)
  createdBy   User     @relation("FxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([currency, rateDate])
  @@map("fx_rates")
}

enum JournalStatus {
  DRAFT
  POSTED

  @@map("journal_status")
}

enum JournalSource {
  MANUAL
  CUSTOMER_INVOICE
  RECEIPT
  REVERSAL
  TRIP_EXPENSE
  TRIP_ACCRUAL
  CREDIT_NOTE
  SUPPLIER_BILL
  SUPPLIER_PAYMENT
  EXPENSE
  OPENING_BALANCE

  @@map("journal_source")
}

/// Journal entry. Lines are written while it is a DRAFT; posting is one update to POSTED, which
/// the database accepts only if the entry balances in USD and its period is open. A posted
/// entry is corrected by a reversing entry (reversalOfId), never edited or deleted.
model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  /// NOL-JE-2026-000001
  number       String        @unique @db.VarChar(30)
  branchId     String        @map("branch_id") @db.Uuid
  entryDate    DateTime      @map("entry_date") @db.Date
  periodId     String        @map("period_id") @db.Uuid
  description  String
  source       JournalSource
  /// The invoice or receipt the entry was made from (null for manual entries and reversals).
  sourceId     String?       @map("source_id") @db.Uuid
  status       JournalStatus @default(DRAFT)
  reversalOfId String?       @unique @map("reversal_of_id") @db.Uuid
  createdById  String        @map("created_by_id") @db.Uuid
  postedById   String?       @map("posted_by_id") @db.Uuid
  postedAt     DateTime?     @map("posted_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch                Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  period                FiscalPeriod     @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reversalOf            JournalEntry?    @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy            JournalEntry?    @relation("JournalReversal")
  createdBy             User             @relation("JournalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy              User?            @relation("JournalPostedBy", fields: [postedById], references: [id], onDelete: Restrict)
  lines                 JournalLine[]
  invoice               CustomerInvoice? @relation("InvoiceJournal")
  receipt               Receipt?         @relation("ReceiptJournal")
  receiptCancel         Receipt?         @relation("ReceiptCancelJournal")
  tripExpense           TripExpense?     @relation("TripExpenseJournal")
  tripExpenseCancel     TripExpense?     @relation("TripExpenseCancelJournal")
  tripAccrual           Trip?            @relation("TripAccrualJournal")
  creditNote            CreditNote?      @relation("CreditNoteJournal")
  supplierBill          SupplierBill?    @relation("SupplierBillJournal")
  supplierBillCancel    SupplierBill?    @relation("SupplierBillCancelJournal")
  supplierPayment       SupplierPayment? @relation("SupplierPaymentJournal")
  supplierPaymentCancel SupplierPayment? @relation("SupplierPaymentCancelJournal")
  expense               Expense?         @relation("ExpenseJournal")
  expenseCancel         Expense?         @relation("ExpenseCancelJournal")

  @@index([branchId, entryDate])
  @@index([source, sourceId])
  @@map("journal_entries")
}

/// One side of a journal entry. Each line is a debit or a credit, in its own currency at its
/// own rate, with the USD amount the entry balances on. Branch, shipment, customer, supplier and
/// trip are the analysis dimensions.
model JournalLine {
  id          String  @id @default(uuid()) @db.Uuid
  entryId     String  @map("entry_id") @db.Uuid
  lineNo      Int     @map("line_no") @db.SmallInt
  accountId   String  @map("account_id") @db.Uuid
  branchId    String  @map("branch_id") @db.Uuid
  shipmentId  String? @map("shipment_id") @db.Uuid
  customerId  String? @map("customer_id") @db.Uuid
  /// Payables lines: the supplier owed or paid.
  supplierId  String? @map("supplier_id") @db.Uuid
  /// Accrued transport lines a carrier bill clears (rule 11a): the trip they belong to.
  tripId      String? @map("trip_id") @db.Uuid
  description String?
  currency    String  @db.Char(3)
  /// Units of `currency` per 1 USD.
  fxRate      Decimal @map("fx_rate") @db.Decimal(18, 8)
  debit       Decimal @default(0) @db.Decimal(18, 4)
  credit      Decimal @default(0) @db.Decimal(18, 4)
  debitUsd    Decimal @default(0) @map("debit_usd") @db.Decimal(18, 4)
  creditUsd   Decimal @default(0) @map("credit_usd") @db.Decimal(18, 4)

  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment    Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  trip        Trip?        @relation(fields: [tripId], references: [id], onDelete: Restrict)
  currencyRef Currency     @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@index([customerId])
  @@index([shipmentId])
  @@index([supplierId])
  @@index([tripId])
  @@map("journal_lines")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("invoice_status")
}

/// Customer invoice for one shipment. Approval posts its journal entry (annex C rules 1-2) and
/// gives it its number; a draft has none. Paid and credited amounts are kept in the invoice
/// currency and as the USD carrying value already relieved, so the last payment or credit note
/// clears the balance exactly. An opening item (isOpening) is a customer's open invoice brought
/// in at go-live (rule 15): approved when recorded, with no shipment and no lines.
model CustomerInvoice {
  id                  String        @id @default(uuid()) @db.Uuid
  /// NOL-INV-2026-000001, set on approval (NOL-OBI-2026-000001 for an opening item).
  number              String?       @unique @db.VarChar(30)
  branchId            String        @map("branch_id") @db.Uuid
  customerId          String        @map("customer_id") @db.Uuid
  /// Null only for an opening item.
  shipmentId          String?       @map("shipment_id") @db.Uuid
  isOpening           Boolean       @default(false) @map("is_opening")
  /// Opening items: the invoice's number in the previous system.
  reference           String?       @db.VarChar(50)
  currency            String        @db.Char(3)
  /// Units of `currency` per 1 USD on the invoice date.
  fxRate              Decimal       @map("fx_rate") @db.Decimal(18, 8)
  /// The rate the client sent, null when it left the rate to the table (idempotent retries).
  requestedFxRate     Decimal?      @map("requested_fx_rate") @db.Decimal(18, 8)
  invoiceDate         DateTime      @map("invoice_date") @db.Date
  dueDate             DateTime      @map("due_date") @db.Date
  status              InvoiceStatus @default(DRAFT)
  total               Decimal       @default(0) @db.Decimal(18, 4)
  totalUsd            Decimal       @default(0) @map("total_usd") @db.Decimal(18, 4)
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 4)
  paidUsd             Decimal       @default(0) @map("paid_usd") @db.Decimal(18, 4)
  /// Approved credit notes against the invoice (rule 6).
  creditedAmount      Decimal       @default(0) @map("credited_amount") @db.Decimal(18, 4)
  creditedUsd         Decimal       @default(0) @map("credited_usd") @db.Decimal(18, 4)
  notes               String?
  journalEntryId      String?       @unique @map("journal_entry_id") @db.Uuid
  /// The receivable account debited on approval; receipts clear the invoice there, even after
  /// the RECEIVABLE role is remapped.
  receivableAccountId String?       @map("receivable_account_id") @db.Uuid
  createdById         String        @map("created_by_id") @db.Uuid
  approvedById        String?       @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?     @map("approved_at") @db.Timestamptz(3)
  cancelReason        String?       @map("cancel_reason")
  cancelledAt         DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch            Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer          Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shipment          Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  currencyRef       Currency              @relation(fields: [currency], references: [code], onDelete: Restrict)
  journalEntry      JournalEntry?         @relation("InvoiceJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  receivableAccount Account?              @relation("InvoiceReceivable", fields: [receivableAccountId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy        User?                 @relation("InvoiceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  lines             CustomerInvoiceLine[]
  allocations       ReceiptAllocation[]
  creditNotes       CreditNote[]

  @@index([branchId, status])
  @@index([customerId])
  @@index([shipmentId])
  @@map("customer_invoices")
}

model CustomerInvoiceLine {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @map("invoice_id") @db.Uuid
  lineNo         Int     @map("line_no") @db.SmallInt
  chargeTypeCode String  @map("charge_type_code") @db.VarChar(20)
  description    String?
  quantity       Decimal @db.Decimal(18, 4)
  unitPrice      Decimal @map("unit_price") @db.Decimal(18, 4)
  /// round(quantity * unitPrice) to the currency's minor units.
  lineTotal      Decimal @map("line_total") @db.Decimal(18, 4)

  invoice    CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  chargeType ChargeType      @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)

  @@unique([invoiceId, lineNo])
  @@map("customer_invoice_lines")
}

enum ReceiptStatus {
  POSTED
  CANCELLED

  @@map("receipt_status")
}

/// Money received from a customer into a cash or bank account (annex C rules 3-4). Recording it
/// posts the entry; the part not allocated to invoices is a customer advance. Cancelling posts a
/// reversing entry and gives the allocated amounts back to the invoices.
model Receipt {
  id                   String        @id @default(uuid()) @db.Uuid
  /// NOL-RC-2026-000001
  number               String        @unique @db.VarChar(30)
  branchId             String        @map("branch_id") @db.Uuid
  customerId           String        @map("customer_id") @db.Uuid
  receiptDate          DateTime      @map("receipt_date") @db.Date
  currency             String        @db.Char(3)
  fxRate               Decimal       @map("fx_rate") @db.Decimal(18, 8)
  amount               Decimal       @db.Decimal(18, 4)
  cashAccountId        String        @map("cash_account_id") @db.Uuid
  reference            String?       @db.VarChar(100)
  notes                String?
  status               ReceiptStatus @default(POSTED)
  journalEntryId       String        @unique @map("journal_entry_id") @db.Uuid
  cancelJournalEntryId String?       @unique @map("cancel_journal_entry_id") @db.Uuid
  cancelReason         String?       @map("cancel_reason")
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?       @map("cancelled_by_id") @db.Uuid
  createdById          String        @map("created_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  branch        Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  currencyRef   Currency            @relation(fields: [currency], references: [code], onDelete: Restrict)
  cashAccount   Account             @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry        @relation("ReceiptJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  cancelJournal JournalEntry?       @relation("ReceiptCancelJournal", fields: [cancelJournalEntryId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy   User?               @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  allocations   ReceiptAllocation[]

  @@index([branchId, receiptDate])
  @@index([customerId])
  @@map("receipts")
}

/// Part of a receipt applied to one invoice, in their shared currency. `relievedUsd` is the USD
/// carrying value of the invoice it cleared, at the invoice rate; the difference from the
/// receipt's USD value is the realized exchange difference.
model ReceiptAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  receiptId   String  @map("receipt_id") @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  amount      Decimal @db.Decimal(18, 4)
  relievedUsd Decimal @map("relieved_usd") @db.Decimal(18, 4)

  receipt Receipt         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoice CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptId, invoiceId])
  @@index([invoiceId])
  @@map("receipt_allocations")
}

// ---------------------------------------------------------------------------------------------
// Group 5a: warehouse (scope 10) and customs (scope 11).
// ---------------------------------------------------------------------------------------------

/**
 * A warehouse of a branch. Master data each branch extends (warehouses and their storage
 * locations are rows, not code). Deactivate instead of deleting: movements reference it.
 */
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  /// Short code, unique across branches, e.g. PTS-MAIN.
  code      String   @unique @db.VarChar(20)
  nameEn    String   @map("name_en") @db.VarChar(200)
  nameAr    String   @map("name_ar") @db.VarChar(200)
  address   String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  storageLocations StorageLocation[]
  movements        WarehouseMovement[]

  @@index([branchId])
  @@map("warehouses")
}

/**
 * A simple storage location inside a warehouse (zone, row or bay: free code). Carries the
 * warehouse's branch.
 */
model StorageLocation {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  code        String   @db.VarChar(20)
  name        String?  @db.VarChar(200)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch    Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements WarehouseMovement[]

  @@unique([warehouseId, code])
  @@index([branchId])
  @@map("storage_locations")
}

enum WarehouseMovementKind {
  /// Goods received: issues a goods received note (GRN).
  RECEIPT
  /// Goods released: issues a goods release note.
  RELEASE

  @@map("warehouse_movement_kind")
}

enum GoodsCondition {
  GOOD
  DAMAGED

  @@map("goods_condition")
}

/**
 * The warehouse movement log of a shipment: one row per goods receipt or release, full or
 * partial. Rows are only inserted. What a warehouse holds for a shipment is the sum of its
 * receipts minus its releases; ShipmentsService.lockForChildWrite serializes the writes, so a
 * release never takes out more than is held. branch_id is the shipment's branch (the record
 * belongs to the shipment's file); the warehouse carries its own branch.
 */
model WarehouseMovement {
  id                String                @id @default(uuid()) @db.Uuid
  /// NOL-GRN-2026-000001 (receipt) or NOL-GRL-2026-000001 (release).
  number            String                @unique @db.VarChar(30)
  kind              WarehouseMovementKind
  branchId          String                @map("branch_id") @db.Uuid
  shipmentId        String                @map("shipment_id") @db.Uuid
  warehouseId       String                @map("warehouse_id") @db.Uuid
  storageLocationId String?               @map("storage_location_id") @db.Uuid
  /// Number of packages (pieces, pallets, containers) received or released.
  packages          Int
  weightKg          Decimal?              @map("weight_kg") @db.Decimal(12, 3)
  /// Required on receipts.
  condition         GoodsCondition?
  /// Who delivered the goods (receipt) or collected them (release).
  partyName         String?               @map("party_name") @db.VarChar(200)
  note              String?
  occurredAt        DateTime              @map("occurred_at") @db.Timestamptz(3)
  /// The shipment status this receipt moved the shipment to, through the state machine.
  statusApplied     ShipmentStatus?       @map("status_applied")
  createdById       String                @map("created_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  branch          Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment        Shipment                 @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  warehouse       Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation?         @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)
  createdBy       User                     @relation("WarehouseMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos          WarehouseMovementPhoto[]

  @@index([shipmentId, warehouseId])
  @@index([warehouseId])
  @@index([branchId])
  @@map("warehouse_movements")
}

/**
 * Photos of a movement. Each is a shipment document (type PHOTO) in the documents module.
 */
model WarehouseMovementPhoto {
  movementId String @map("movement_id") @db.Uuid
  /// One movement per photo.
  documentId String @unique @map("document_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid

  movement WarehouseMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  document Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  branch   Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([movementId, documentId])
  @@index([branchId])
  @@map("warehouse_movement_photos")
}

enum CustomsStatus {
  PENDING
  SUBMITTED
  INSPECTION
  HELD
  CLEARED

  @@map("customs_status")
}

/**
 * The customs file of a shipment (scope 11): one per shipment. Its status is the clearance's
 * own; the shipment's CUSTOMS_IN_PROGRESS / CUSTOMS_CLEARED statuses stay with the state machine.
 */
model CustomsClearance {
  id                String        @id @default(uuid()) @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  shipmentId        String        @unique @map("shipment_id") @db.Uuid
  status            CustomsStatus @default(PENDING)
  /// Declaration or file number at customs.
  declarationNumber String?       @map("declaration_number") @db.VarChar(50)
  brokerName        String?       @map("broker_name") @db.VarChar(200)
  submittedOn       DateTime?     @map("submitted_on") @db.Date
  clearedOn         DateTime?     @map("cleared_on") @db.Date
  note              String?
  updatedById       String        @map("updated_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment  Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  updatedBy User     @relation("CustomsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@map("customs_clearances")
}

/**
 * Customs fees paid for a shipment, in their currency. Recorded only: no journal entry yet.
 * They become supplier costs with the supplier bills (group 4b).
 */
model CustomsFee {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  shipmentId  String   @map("shipment_id") @db.Uuid
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(18, 4)
  currency    String   @db.Char(3)
  note        String?
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onUpdate: Restrict, onDelete: Restrict)
  createdBy   User     @relation("CustomsFeeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([branchId])
  @@map("customs_fees")
}

// ---------------------------------------------------------------------------------------------
// Inland transport (scope 12): fleet, trips, trip costs, proof of delivery
// ---------------------------------------------------------------------------------------------

/// An owned vehicle of a branch.
model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  branchId    String   @map("branch_id") @db.Uuid
  /// Stored upper-cased and trimmed.
  plateNumber String   @unique @map("plate_number") @db.VarChar(30)
  /// Free text the client extends (flatbed, 40ft trailer...).
  vehicleType String   @map("vehicle_type") @db.VarChar(100)
  capacityKg  Decimal? @map("capacity_kg") @db.Decimal(12, 3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trips  Trip[]

  @@index([branchId])
  @@map("vehicles")
}

/// A driver of a branch, optionally linked to the user account (DRIVER role) that sees their trips.
model Driver {
  id            String   @id @default(uuid()) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  name          String   @db.VarChar(200)
  phone         String?  @db.VarChar(20)
  licenseNumber String?  @map("license_number") @db.VarChar(50)
  userId        String?  @unique @map("user_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)
  trips  Trip[]

  @@index([branchId])
  @@map("drivers")
}

/// External carrier (hired trucks). Master data shared by all branches.
model Carrier {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(200)
  phone      String?  @db.VarChar(20)
  /// The supplier whose bills settle this carrier's trips (rule 11a).
  supplierId String?  @map("supplier_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  trips    Trip[]

  @@map("carriers")
}

enum TripKind {
  OWN
  EXTERNAL

  @@map("trip_kind")
}

enum TripStatus {
  PLANNED
  DEPARTED
  ARRIVED
  COMPLETED
  CANCELLED

  @@map("trip_status")
}

model Trip {
  id                    String     @id @default(uuid()) @db.Uuid
  /// NOL-TRP-2026-000001
  number                String     @unique @db.VarChar(30)
  branchId              String     @map("branch_id") @db.Uuid
  kind                  TripKind
  status                TripStatus @default(PLANNED)
  originLocationId      String     @map("origin_location_id") @db.Uuid
  destinationLocationId String     @map("destination_location_id") @db.Uuid
  plannedDeparture      DateTime?  @map("planned_departure") @db.Timestamptz(3)
  plannedArrival        DateTime?  @map("planned_arrival") @db.Timestamptz(3)
  actualDeparture       DateTime?  @map("actual_departure") @db.Timestamptz(3)
  actualArrival         DateTime?  @map("actual_arrival") @db.Timestamptz(3)
  completedAt           DateTime?  @map("completed_at") @db.Timestamptz(3)
  /// Own trips.
  vehicleId             String?    @map("vehicle_id") @db.Uuid
  driverId              String?    @map("driver_id") @db.Uuid
  /// External trips: the carrier, the agreed cost and the truck and driver as written.
  carrierId             String?    @map("carrier_id") @db.Uuid
  agreedCost            Decimal?   @map("agreed_cost") @db.Decimal(18, 4)
  currency              String?    @db.Char(3)
  externalVehicle       String?    @map("external_vehicle") @db.VarChar(100)
  externalDriver        String?    @map("external_driver") @db.VarChar(200)
  /// Rule 11: the accrual posted when the external trip is completed.
  accrualEntryId        String?    @unique @map("accrual_entry_id") @db.Uuid
  /// Rule 11a: the approved carrier bill that cleared the accrual (null again if it is cancelled).
  carrierBillId         String?    @map("carrier_bill_id") @db.Uuid
  notes                 String?
  cancelReason          String?    @map("cancel_reason")
  cancelledAt           DateTime?  @map("cancelled_at") @db.Timestamptz(3)
  createdById           String     @map("created_by_id") @db.Uuid
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  origin       Location           @relation("TripOrigin", fields: [originLocationId], references: [id], onDelete: Restrict)
  destination  Location           @relation("TripDestination", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver       Driver?            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  carrier      Carrier?           @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  currencyRef  Currency?          @relation(fields: [currency], references: [code], onUpdate: Restrict, onDelete: Restrict)
  accrualEntry JournalEntry?      @relation("TripAccrualJournal", fields: [accrualEntryId], references: [id], onDelete: Restrict)
  carrierBill  SupplierBill?      @relation("TripCarrierBill", fields: [carrierBillId], references: [id], onDelete: Restrict)
  billLines    SupplierBillLine[]
  journalLines JournalLine[]
  createdBy    User               @relation("TripCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  shipments    TripShipment[]
  expenses     TripExpense[]
  pods         ProofOfDelivery[]

  @@index([branchId, status])
  @@index([driverId])
  @@map("trips")
}

/// A shipment carried on a trip (one road leg of the shipment).
model TripShipment {
  tripId     String   @map("trip_id") @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  /// The trip's branch.
  branchId   String   @map("branch_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Restrict)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([tripId, shipmentId])
  @@index([shipmentId])
  @@index([branchId])
  @@map("trip_shipments")
}

enum TripExpenseStatus {
  POSTED
  CANCELLED

  @@map("trip_expense_status")
}

/// Rule 10: an expense of an own-vehicle trip, paid from a cash or bank account.
model TripExpense {
  id                   String            @id @default(uuid()) @db.Uuid
  /// NOL-TEX-2026-000001
  number               String            @unique @db.VarChar(30)
  branchId             String            @map("branch_id") @db.Uuid
  tripId               String            @map("trip_id") @db.Uuid
  expenseDate          DateTime          @map("expense_date") @db.Date
  description          String            @db.VarChar(200)
  amount               Decimal           @db.Decimal(18, 4)
  currency             String            @db.Char(3)
  fxRate               Decimal           @map("fx_rate") @db.Decimal(18, 8)
  cashAccountId        String            @map("cash_account_id") @db.Uuid
  status               TripExpenseStatus @default(POSTED)
  journalEntryId       String            @unique @map("journal_entry_id") @db.Uuid
  cancelJournalEntryId String?           @unique @map("cancel_journal_entry_id") @db.Uuid
  cancelReason         String?           @map("cancel_reason")
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?           @map("cancelled_by_id") @db.Uuid
  createdById          String            @map("created_by_id") @db.Uuid
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  trip          Trip          @relation(fields: [tripId], references: [id], onDelete: Restrict)
  currencyRef   Currency      @relation(fields: [currency], references: [code], onUpdate: Restrict, onDelete: Restrict)
  cashAccount   Account       @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry  @relation("TripExpenseJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  cancelJournal JournalEntry? @relation("TripExpenseCancelJournal", fields: [cancelJournalEntryId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("TripExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy   User?         @relation("TripExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([branchId])
  @@map("trip_expenses")
}

/// Proof of delivery: one per delivery (or partial delivery batch) of a shipment.
model ProofOfDelivery {
  id                  String          @id @default(uuid()) @db.Uuid
  /// NOL-POD-2026-000001
  number              String          @unique @db.VarChar(30)
  /// The shipment's branch.
  branchId            String          @map("branch_id") @db.Uuid
  shipmentId          String          @map("shipment_id") @db.Uuid
  tripId              String?         @map("trip_id") @db.Uuid
  recipientName       String          @map("recipient_name") @db.VarChar(200)
  recipientCapacity   String          @map("recipient_capacity") @db.VarChar(100)
  deliveredAt         DateTime        @map("delivered_at") @db.Timestamptz(3)
  packages            Int?
  note                String?
  statusApplied       ShipmentStatus? @map("status_applied")
  /// The on-screen signature, a PNG shipment document of type POD.
  signatureDocumentId String          @unique @map("signature_document_id") @db.Uuid
  createdById         String          @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  trip      Trip?      @relation(fields: [tripId], references: [id], onDelete: Restrict)
  signature Document   @relation("PodSignature", fields: [signatureDocumentId], references: [id], onDelete: Restrict)
  createdBy User       @relation("PodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  photos    PodPhoto[]

  @@index([shipmentId])
  @@index([tripId])
  @@index([branchId])
  @@map("proofs_of_delivery")
}

model PodPhoto {
  podId      String @map("pod_id") @db.Uuid
  documentId String @unique @map("document_id") @db.Uuid
  branchId   String @map("branch_id") @db.Uuid

  pod      ProofOfDelivery @relation(fields: [podId], references: [id], onDelete: Restrict)
  document Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@id([podId, documentId])
  @@index([branchId])
  @@map("pod_photos")
}

// ---------------------------------------------------------------------------------------------
// Group 4b: credit notes, payables (suppliers, bills, payments), general expenses, opening
// balances (scope 13, annex C rules 6, 7, 9, 11a, 12 and 15).
// ---------------------------------------------------------------------------------------------

enum CreditNoteStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("credit_note_status")
}

/// A credit note against an approved customer invoice (rule 6), for all or part of its open
/// amount, in the invoice's currency and at its rate. Approval posts the reversing entry: debit
/// the invoice's revenue accounts in proportion, credit its receivable.
model CreditNote {
  id             String           @id @default(uuid()) @db.Uuid
  /// NOL-CN-2026-000001, set on approval.
  number         String?          @unique @db.VarChar(30)
  /// The invoice's branch.
  branchId       String           @map("branch_id") @db.Uuid
  invoiceId      String           @map("invoice_id") @db.Uuid
  customerId     String           @map("customer_id") @db.Uuid
  creditDate     DateTime         @map("credit_date") @db.Date
  /// In the invoice currency.
  amount         Decimal          @db.Decimal(18, 4)
  /// The USD carrying value of the invoice it cleared, set on approval.
  amountUsd      Decimal?         @map("amount_usd") @db.Decimal(18, 4)
  reason         String
  status         CreditNoteStatus @default(DRAFT)
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  createdById    String           @map("created_by_id") @db.Uuid
  approvedById   String?          @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(3)
  cancelReason   String?          @map("cancel_reason")
  cancelledAt    DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  cancelledById  String?          @map("cancelled_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  invoice      CustomerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?   @relation("CreditNoteJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  createdBy    User            @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy   User?           @relation("CreditNoteApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy  User?           @relation("CreditNoteCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([branchId, status])
  @@index([invoiceId])
  @@map("credit_notes")
}

/// A supplier: shipping line, carrier, customs broker, warehouse... Master data shared by all
/// branches (like carriers); its bills and payments are branch-owned. Deactivate, never delete.
model Supplier {
  id               String   @id @default(uuid()) @db.Uuid
  /// NOL-SUP-000001
  number           String   @unique @db.VarChar(30)
  name             String   @db.VarChar(200)
  /// E.164.
  phone            String?  @db.VarChar(20)
  email            String?  @db.VarChar(254)
  taxNumber        String?  @map("tax_number") @db.VarChar(50)
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  notes            String?
  isActive         Boolean  @default(true) @map("is_active")
  createdById      String   @map("created_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User              @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  carriers     Carrier[]
  bills        SupplierBill[]
  payments     SupplierPayment[]
  journalLines JournalLine[]

  @@map("suppliers")
}

enum SupplierBillStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("supplier_bill_status")
}

/// A supplier's bill (accounts payable), in one branch and currency. Edited as a DRAFT; approval
/// numbers it and posts its entry (rules 7, 8, 11a, 12): debit each line's cost, clearing or
/// expense account, credit the payable. An approved bill with no payment can be cancelled, which
/// posts the reversing entry. An opening item (isOpening) is an open bill brought in at go-live
/// (rule 15): approved when recorded, with no lines.
model SupplierBill {
  id                   String             @id @default(uuid()) @db.Uuid
  /// NOL-SB-2026-000001, set on approval (NOL-OBS-2026-000001 for an opening item).
  number               String?            @unique @db.VarChar(30)
  branchId             String             @map("branch_id") @db.Uuid
  supplierId           String             @map("supplier_id") @db.Uuid
  /// The supplier's own invoice number.
  supplierReference    String?            @map("supplier_reference") @db.VarChar(50)
  isOpening            Boolean            @default(false) @map("is_opening")
  currency             String             @db.Char(3)
  fxRate               Decimal            @map("fx_rate") @db.Decimal(18, 8)
  /// The rate the client sent, null when it left the rate to the table (idempotent retries).
  requestedFxRate      Decimal?           @map("requested_fx_rate") @db.Decimal(18, 8)
  billDate             DateTime           @map("bill_date") @db.Date
  dueDate              DateTime           @map("due_date") @db.Date
  status               SupplierBillStatus @default(DRAFT)
  total                Decimal            @default(0) @db.Decimal(18, 4)
  totalUsd             Decimal            @default(0) @map("total_usd") @db.Decimal(18, 4)
  paidAmount           Decimal            @default(0) @map("paid_amount") @db.Decimal(18, 4)
  paidUsd              Decimal            @default(0) @map("paid_usd") @db.Decimal(18, 4)
  notes                String?
  journalEntryId       String?            @unique @map("journal_entry_id") @db.Uuid
  cancelJournalEntryId String?            @unique @map("cancel_journal_entry_id") @db.Uuid
  /// The payable account credited on approval; payments clear the bill there.
  payableAccountId     String?            @map("payable_account_id") @db.Uuid
  createdById          String             @map("created_by_id") @db.Uuid
  approvedById         String?            @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?          @map("approved_at") @db.Timestamptz(3)
  cancelReason         String?            @map("cancel_reason")
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?            @map("cancelled_by_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch         Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier       Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currencyRef    Currency                    @relation(fields: [currency], references: [code], onDelete: Restrict)
  journalEntry   JournalEntry?               @relation("SupplierBillJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  cancelJournal  JournalEntry?               @relation("SupplierBillCancelJournal", fields: [cancelJournalEntryId], references: [id], onDelete: Restrict)
  payableAccount Account?                    @relation("BillPayable", fields: [payableAccountId], references: [id], onDelete: Restrict)
  createdBy      User                        @relation("SupplierBillCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?                       @relation("SupplierBillApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy    User?                       @relation("SupplierBillCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  lines          SupplierBillLine[]
  allocations    SupplierPaymentAllocation[]
  trips          Trip[]                      @relation("TripCarrierBill")

  @@index([branchId, status])
  @@index([supplierId])
  @@map("supplier_bills")
}

enum SupplierBillLineKind {
  /// A cost of one shipment by charge type (rule 7; reimbursable charges rule 8).
  SHIPMENT_COST
  /// A carrier's charge for a completed external trip, clearing its accrual (rule 11a).
  TRIP
  /// A general expense by category (rule 12).
  EXPENSE

  @@map("supplier_bill_line_kind")
}

model SupplierBillLine {
  id                  String               @id @default(uuid()) @db.Uuid
  billId              String               @map("bill_id") @db.Uuid
  lineNo              Int                  @map("line_no") @db.SmallInt
  kind                SupplierBillLineKind
  chargeTypeCode      String?              @map("charge_type_code") @db.VarChar(20)
  shipmentId          String?              @map("shipment_id") @db.Uuid
  tripId              String?              @map("trip_id") @db.Uuid
  expenseCategoryCode String?              @map("expense_category_code") @db.VarChar(20)
  description         String?
  /// In the bill currency, rounded to its minor units.
  amount              Decimal              @db.Decimal(18, 4)

  bill            SupplierBill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  chargeType      ChargeType?      @relation(fields: [chargeTypeCode], references: [code], onDelete: Restrict)
  shipment        Shipment?        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  trip            Trip?            @relation(fields: [tripId], references: [id], onDelete: Restrict)
  expenseCategory ExpenseCategory? @relation(fields: [expenseCategoryCode], references: [code], onDelete: Restrict)

  @@unique([billId, lineNo])
  @@index([shipmentId])
  @@index([tripId])
  @@map("supplier_bill_lines")
}

enum SupplierPaymentStatus {
  POSTED
  CANCELLED

  @@map("supplier_payment_status")
}

/// Money paid to a supplier from a cash or bank account (rule 9), allocated in full to approved
/// bills of the supplier, branch and currency. Recording it posts the entry with any realized
/// exchange difference (annex C section 3); cancelling posts the reversing entry.
model SupplierPayment {
  id                   String                @id @default(uuid()) @db.Uuid
  /// NOL-SP-2026-000001
  number               String                @unique @db.VarChar(30)
  branchId             String                @map("branch_id") @db.Uuid
  supplierId           String                @map("supplier_id") @db.Uuid
  paymentDate          DateTime              @map("payment_date") @db.Date
  currency             String                @db.Char(3)
  fxRate               Decimal               @map("fx_rate") @db.Decimal(18, 8)
  /// The rate the client sent, null when it left the rate to the table: an idempotent retry is
  /// compared with this, never with the (editable) rate table.
  requestedFxRate      Decimal?              @map("requested_fx_rate") @db.Decimal(18, 8)
  amount               Decimal               @db.Decimal(18, 4)
  cashAccountId        String                @map("cash_account_id") @db.Uuid
  reference            String?               @db.VarChar(100)
  notes                String?
  status               SupplierPaymentStatus @default(POSTED)
  journalEntryId       String                @unique @map("journal_entry_id") @db.Uuid
  cancelJournalEntryId String?               @unique @map("cancel_journal_entry_id") @db.Uuid
  cancelReason         String?               @map("cancel_reason")
  cancelledAt          DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?               @map("cancelled_by_id") @db.Uuid
  createdById          String                @map("created_by_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  branch        Branch                      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier      Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  currencyRef   Currency                    @relation(fields: [currency], references: [code], onDelete: Restrict)
  cashAccount   Account                     @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry                @relation("SupplierPaymentJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  cancelJournal JournalEntry?               @relation("SupplierPaymentCancelJournal", fields: [cancelJournalEntryId], references: [id], onDelete: Restrict)
  createdBy     User                        @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy   User?                       @relation("SupplierPaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  allocations   SupplierPaymentAllocation[]

  @@index([branchId, paymentDate])
  @@index([supplierId])
  @@map("supplier_payments")
}

/// Part of a payment applied to one bill. `relievedUsd` is the bill's USD carrying value it
/// cleared; the difference from the payment's USD value is the realized exchange difference.
model SupplierPaymentAllocation {
  id          String  @id @default(uuid()) @db.Uuid
  paymentId   String  @map("payment_id") @db.Uuid
  billId      String  @map("bill_id") @db.Uuid
  amount      Decimal @db.Decimal(18, 4)
  relievedUsd Decimal @map("relieved_usd") @db.Decimal(18, 4)

  payment SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bill    SupplierBill    @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentId, billId])
  @@index([billId])
  @@map("supplier_payment_allocations")
}

/// Kinds of general expense (rent, utilities, office...) and the expense account each posts to
/// (rule 12). Master data the client extends; deactivate, never delete.
model ExpenseCategory {
  code      String   @id @db.VarChar(20)
  nameEn    String   @map("name_en") @db.VarChar(200)
  nameAr    String   @map("name_ar") @db.VarChar(200)
  accountId String   @map("account_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  expenses  Expense[]
  billLines SupplierBillLine[]

  @@map("expense_categories")
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("expense_status")
}

/// A general expense (not tied to a shipment) paid from a cash or bank account (rule 12). Edited
/// as a DRAFT; approval numbers it and posts its entry: debit the category's account, credit the
/// cash account. An approved expense is cancelled by the reversing entry.
model Expense {
  id                   String        @id @default(uuid()) @db.Uuid
  /// NOL-EXP-2026-000001, set on approval.
  number               String?       @unique @db.VarChar(30)
  branchId             String        @map("branch_id") @db.Uuid
  expenseDate          DateTime      @map("expense_date") @db.Date
  categoryCode         String        @map("category_code") @db.VarChar(20)
  description          String        @db.VarChar(200)
  amount               Decimal       @db.Decimal(18, 4)
  currency             String        @db.Char(3)
  fxRate               Decimal       @map("fx_rate") @db.Decimal(18, 8)
  /// The rate the client sent, null when it left the rate to the table (idempotent retries).
  requestedFxRate      Decimal?      @map("requested_fx_rate") @db.Decimal(18, 8)
  cashAccountId        String        @map("cash_account_id") @db.Uuid
  reference            String?       @db.VarChar(100)
  status               ExpenseStatus @default(DRAFT)
  journalEntryId       String?       @unique @map("journal_entry_id") @db.Uuid
  cancelJournalEntryId String?       @unique @map("cancel_journal_entry_id") @db.Uuid
  createdById          String        @map("created_by_id") @db.Uuid
  approvedById         String?       @map("approved_by_id") @db.Uuid
  approvedAt           DateTime?     @map("approved_at") @db.Timestamptz(3)
  cancelReason         String?       @map("cancel_reason")
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?       @map("cancelled_by_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  category      ExpenseCategory @relation(fields: [categoryCode], references: [code], onDelete: Restrict)
  currencyRef   Currency        @relation(fields: [currency], references: [code], onDelete: Restrict)
  cashAccount   Account         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry  JournalEntry?   @relation("ExpenseJournal", fields: [journalEntryId], references: [id], onDelete: Restrict)
  cancelJournal JournalEntry?   @relation("ExpenseCancelJournal", fields: [cancelJournalEntryId], references: [id], onDelete: Restrict)
  createdBy     User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?           @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy   User?           @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([branchId, expenseDate])
  @@map("expenses")
}
