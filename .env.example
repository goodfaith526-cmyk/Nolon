# Copy to apps/api/.env (the API and the Prisma CLI read it from there).
DATABASE_URL=postgresql://nolon:nolon@localhost:5432/nolon?schema=public
PORT=4000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Public web address for tracking links and QR codes (empty: the first CORS origin).
PUBLIC_WEB_URL=
# Sign-in sessions last this many hours.
SESSION_TTL_HOURS=12
# Lifetime of a staff AI assistant token, 5 to 10 minutes.
AGENT_TOKEN_TTL_MINUTES=10
# Reverse proxies in front of the API (0 locally). See docs/plans/01-auth-and-permissions.md S1.
TRUST_PROXY_HOPS=0
LOGIN_IP_LIMIT_ENABLED=true
# A new quotation's valid-until starts this many days after the branch's today (1 to 365).
QUOTATION_VALIDITY_DAYS=30
# Seed only: first Administrator, created by `pnpm db:seed` if missing. Use your own values.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-to-a-long-password

# Unified bot customer capture (plan 08). Off until both repositories pass the contract tests.
CS_CUSTOMER_IDENTITY_ENABLED=false
CS_CUSTOMER_FOLLOWUP_ENABLED=false
CS_CUSTOMER_BOOKING_IDENTITY_ENABLED=false
# Plan 09: customers cancel bot booking requests. On only after the bot accepts 'cancelled'.
CS_BOOKING_CANCEL_ENABLED=false
CS_ESTIMATES_ENABLED=false
# Plan 12: approve the invoice made on booking confirmation by the system rule. Off: a draft.
BILLING_AUTO_APPROVE_ENABLED=false
# Plan 12 section 3: goods are handed over at the destination only invoiced and paid (or within the credit limit).
HANDOVER_PAYMENT_GATE_ENABLED=false
# The owner's instant account: a signed bot request makes the branch account when saved.
CS_INSTANT_CUSTOMER_ENABLED=false
CS_RECEIVER_CUSTOMER_ENABLED=false
# Plan 12 section 4: approving a bot request also confirms its booking (off by default).
CS_APPROVE_CONFIRMS_ENABLED=false
# Plan 13 section 2: the window desk for partner outlets (off by default).
WINDOW_DESK_ENABLED=false
# Owner 2026-11-05: POST /cs/quotations saves the bot's prices in Quotations (off by default).
CS_QUOTE_SAVE_ENABLED=false
# Plan 14-1: customer tokens from a Telegram own shared contact (signed assertion).
CS_TELEGRAM_TOKENS_ENABLED=false
# Plan 14-2: GET /cs/me/statement (off by default).
CS_STATEMENT_ENABLED=false
# Plan 09 section 5: signed notices to the bot. Secret 32-256 chars (never committed); hosts comma-separated.
CS_WEBHOOK_SECRET=
CS_WEBHOOK_ALLOWED_HOSTS=
CS_WEBHOOK_WORKER_ENABLED=false
# Stable namespace of this single-company deployment. No company id is accepted from API bodies.
CS_CUSTOMER_IDENTITY_COMPANY_ID=
# Private JSON keyed by API client UUID: secret (>=32 chars), accounts [{channel,channelAccountId}].
# Configure only in the deployment's secret store; never copy a live value into the repository.
CS_CUSTOMER_IDENTITY_CLIENTS={}
# Owner 2026-11-06: the website chat's channel account (e.g. nolon); empty = no WEB identity.
CS_WEB_IDENTITY_ACCOUNT=
